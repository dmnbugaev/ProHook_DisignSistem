# Токен МойСклад (https://online.moysklad.ru → Профиль → API-токены).
# Подаётся и в продакшене через переменные окружения сервера.
NUXT_MOYSKLAD_TOKEN=your_moysklad_access_token
# Запасной вариант имени переменной (используется, если NUXT_ не задана).
MOYSKLAD_TOKEN=

# Канонический домен сайта для canonical/sitemap/robots (по умолчанию
# https://прохук.рф; меняется только для нестендартовых окружений).
# NUXT_PUBLIC_SITE_URL=https://прохук.рф

# Яндекс.Метрика 113582832 (app/plugins/yandex-metrika.client.ts):
# auto — счётчик грузится только в production-сборке на публичном домене
# (dev и localhost не отправляют данные); 0 — отключить принудительно;
# 1 — включить принудительно (режим e2e-проверки интеграции,
# tests/metrika.spec.ts).
# NUXT_PUBLIC_METRIKA_ENABLED=auto

# Запасной вариант имени переменной (используется, если NUXT_ не задана).
MOYSKLAD_TOKEN=

# Telegram-бот для заявок на сотрудничество (создаётся через @BotFather).
NUXT_TELEGRAM_BOT_TOKEN=
# Один или несколько chat_id через запятую: 6939112736,-1001234567890
NUXT_TELEGRAM_CHAT_ID=

# Telegram-бот уведомлений о запросах на резерв (@prohook_bunker_site_bot).
# Токен задаётся ТОЛЬКО в server-side окружении (никогда не в Git и не в
# клиентском коде). Проверяется на сервере в момент отправки уведомления.
TELEGRAM_BOT_TOKEN=
# Разрешённые получатели уведомлений о запросах на резерв (allowlist,
# числовые chat_id через запятую). Клиент эти значения не получает.
TELEGRAM_RESERVATION_CHAT_IDS=6939112736,1107248048,5313920922,8562692667
# Пауза между повторами доставки уведомлений, мс (по умолчанию 60000;
# используется только в тестах).
# TELEGRAM_RETRY_DELAY_MS=

# Инбокс сотрудников (GET /api/staff/inbox + раздел в личном кабинете):
# резервный канал просмотра заявок, когда Telegram-уведомления с хостинга
# не доставляются (хостер VPS блокирует api.telegram.org). Нормализованные
# телефоны аккаунтов через запятую: 79991234567,79997654321. Пусто — инбокс
# выключен; заявки при этом всё равно сохраняются сервером.
STAFF_INBOX_PHONES=

# Резервный канал уведомлений о заявках: задачи в МойСклад. Используется
# автоматически, когда Telegram недоступен (сетевой сбой после ретраев).
# Исполнитель задачи по умолчанию — владелец API-токена МойСклад; можно
# указать id конкретного сотрудника (entity/employee).
# MOYSKLAD_NOTIFY_EMPLOYEE_ID=

# Yandex SmartCaptcha (консоль yandex.cloud → SmartCaptcha) защищает
# форму запроса на резерв от спама. Серверный ключ проверяет токен ТОЛЬКО
# на сервере (server/services/smartcaptcha.ts); без него проверка капчи
# отключена — для production ключ обязателен (см. docs/COMPLIANCE.md).
SMARTCAPTCHA_SERVER_KEY=
# Клиентский ключ (sitekey) виджета — публичный, попадает в frontend.
NUXT_PUBLIC_SMARTCAPTCHA_CLIENT_KEY=

# Хранилище запросов на резерв (.data/reservations — вне Git).
# RESERVATION_DATA_DIR=

# Бонусная система Тейка (https://teyca.ru → Интеграция → API).
# Основной ключ API. Секрет: только server-side, не публикуется нигде.
TEYCA_API_KEY=
# Готовый токен экземпляра (необязательно; иначе создаётся автоматически
# с идентификатором TEYCA_IDENTIFIER и сохраняется в ACCOUNT_DATA_DIR).
# TEYCA_API_TOKEN=
# TEYCA_IDENTIFIER=prohook-website

# Каталог аккаунтов (пользователи, сессии, токен Тейка). По умолчанию
# .data/account — вне Git. Не указывайте без необходимости.
# ACCOUNT_DATA_DIR=

# Яндекс.Карты. Ключ JS API (developer.tech.yandex.ru → «Ключи» →
# «JavaScript API и Maps HTTP API») — публичный: он виден в адресе скрипта
# карты на странице. Необязателен: без ключа карта работает, но API пишет
# предупреждение в консоль браузера. В Git не коммитится.
# NUXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Ключ Геокодера Яндекса (тот же кабинет developer.tech.yandex.ru, сервис
# «Геокодер HTTP API») — только для scripts/geocode-stores.mjs: пересобирает
# store-coordinates.json через Яндекс (`--provider yandex`).
# YANDEX_GEOCODER_API_KEY=

# Ключ Catalog API 2ГИС (https://dev.2gis.com → «Ключи») — запасной геокодер
# для scripts/geocode-stores.mjs (`--provider 2gis`).
# TWOGIS_CATALOG_API_KEY=

# Пути к снимку каталога. MOYSKLAD_SNAPSHOT_PATH — только для тестов
# (Playwright указывает на tests/fixtures/catalog.json).
# MOYSKLAD_SNAPSHOT_PATH=
