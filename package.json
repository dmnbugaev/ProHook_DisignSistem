{
  "name": "prohook-design-system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "nuxt preview --host 127.0.0.1",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check app nuxt.config.ts playwright.config.ts tests scripts eslint.config.mjs package.json .prettierrc.json",
    "format": "prettier --write app nuxt.config.ts playwright.config.ts tests scripts eslint.config.mjs package.json .prettierrc.json"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "nuxt": "^4.5.2",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vue-tsc": "^3.3.11"
  }
}
